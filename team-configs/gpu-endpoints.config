# Legacy endpoint reference. Cursor skills do not read runtime config here.
# On the VM, credentials come from /config/<team>.config.
#
# Auth: -H "Authorization: Bearer ${GPU_BEARER_TOKEN}"

GPU_HOST=166.19.38.112
GPU_BEARER_TOKEN=<fill_me>

# Cosmos Reason2 — VLM reasoning / synthesis
COSMOS_REASON2_URL=http://166.19.38.112:8001
COSMOS_REASON2_MODEL=./Cosmos-Reason2-8B

# YOLO11 — object detection (Ultralytics; not an NVIDIA Cosmos model)
YOLO_URL=http://166.19.38.112:8002
YOLO_MODEL=yolo11s.pt

# Cosmos Embed1 — text / visual embeddings (256-dim)
COSMOS_EMBED1_URL=http://166.19.38.112:8003
COSMOS_EMBED1_MODEL=nvidia/cosmos-embed1
COSMOS_EMBED1_DIMS=256

# Canary-1B — ASR / speech translation (NeMo; NOT in the default VSS pipeline)
CANARY_1B_URL=http://166.19.38.112:8004
CANARY_1B_MODEL=nvidia/canary-1b
